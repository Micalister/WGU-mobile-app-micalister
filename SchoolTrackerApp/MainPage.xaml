<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SchoolTrackerApp.MainPage"
             BackgroundColor="{StaticResource Primary}"
             xmlns:models="clr-namespace:SchoolTrackerApp.Models">

    <ScrollView Padding="0, 10, 0, 0">
    
<!-- starting the process of changing the design -->
<!-- these tags tell the xaml to unpack each term into the design -->
<CollectionView ItemsSource="{Binding MyRoadmap.Terms}">
    <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="models:Terms">
            <!-- Phone Body -->
            <VerticalStackLayout Padding="20, 0">
                
                <!-- CARD BODY -->
                <Border BackgroundColor="White" 
                        StrokeThickness="0" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" 
                        WidthRequest="342" 
                        HeightRequest="478">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,30,30,30" />
                    </Border.StrokeShape>
                    
                    <!-- Card Content -->
                    <VerticalStackLayout Padding="20" Spacing="10">

                        <!-- Term Header -->
                        <Grid ColumnDefinitions="1.8*, Auto, Auto, Auto" VerticalOptions="Center">
                            <!-- Term Label -->
                            <Label Grid.Column="0" 
                                Text="{Binding TermID}" 
                                FontSize="24" 
                                FontAttributes="Bold" 
                                TextColor="Black" 
                                VerticalOptions="Center" />
                            
                            <!-- Start Date Variable -->
                            <Label Grid.Column="1" 
                                Text="{Binding TermStartDate, StringFormat='{0:MM/dd/yy}'}" 
                                FontSize="14" 
                                TextColor="Gray" 
                                HorizontalOptions="End" 
                                VerticalOptions="Center" />

                            <!-- "-" placement -->
                            <Label Grid.Column="2" 
                                Text="-" 
                                Margin="2, 0"
                                FontSize="14" 
                                TextColor="Gray" 
                                HorizontalOptions="End" 
                                VerticalOptions="Center" />

                            <!-- End Date Variable -->
                            <Label Grid.Column="3" 
                                Text="{Binding TermEndDate, StringFormat='{0:MM/dd/yy}'}" 
                                FontSize="14" 
                                TextColor="Gray" 
                                HorizontalOptions="End" 
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- Class Stack for the Term -->
                        <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Classes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Classes">
                                    <!-- Classes Unpacked -->
                                    <Border HeightRequest="50" BackgroundColor="{StaticResource Primary}" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="100"/></Border.StrokeShape>
                                        <!-- Content of the class -->
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="Start" VerticalOptions="Center" Margin="7, 0">
                                        <Grid HorizontalOptions="Start" VerticalOptions="Center" Margin="4, 0">
                                            
                                            <Border Stroke="Transparent"
                                                    BackgroundColor="White"
                                                    HeightRequest="36"
                                                    WidthRequest="36">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="100" />
                                                </Border.StrokeShape>
                                            </Border>
                                            <!-- Class Credits -->
                                            <Label Text="{Binding Credits}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                TextColor="{StaticResource Primary}"
                                                FontSize="28"
                                                FontAttributes="Bold"/>
                                        </Grid>
                                        <!-- Class Name -->
                                        <Label Text="{Binding ClassName}"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center"
                                            TextColor="White"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            Margin="0"/>
                                        </StackLayout>
                                        
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>


                    </VerticalStackLayout>
                </Border>

                <ImageButton Source="expand.png"
                            Clicked="ExpandButton_Clicked"
                            BackgroundColor="Transparent"
                            WidthRequest="50"
                            HeightRequest="50"
                            HorizontalOptions="End"
                            TranslationX="14"
                            TranslationY="-250"
                            />

            </VerticalStackLayout>
        </DataTemplate>
    </CollectionView.ItemTemplate>
</CollectionView>

</ScrollView>

</ContentPage>
