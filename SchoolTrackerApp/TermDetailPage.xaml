<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SchoolTrackerApp.TermDetailPage"
             Title="Term Details"
             BackgroundColor="{StaticResource Primary}"
             xmlns:models="clr-namespace:SchoolTrackerApp.Models"> 


    <ScrollView Padding="0, 0, 0, 0">
        <VerticalStackLayout Padding="20" Spacing="10">  
            <ImageButton Source="exit.png"
                            Clicked="ExitButton_Clicked"
                            BackgroundColor="Transparent"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            TranslationX="0"
                            TranslationY="10"
                            />   
            <Border BackgroundColor="White" TranslationY="-30"
                        StrokeThickness="0" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" 
                        WidthRequest="342" 
                        HeightRequest="6322">
                        
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,30,30,30" />
                        </Border.StrokeShape>
                        
                        <!-- Card Content -->
                        <VerticalStackLayout Padding="20" Spacing="10">
                            <!-- Term Header -->
                        <Grid ColumnDefinitions="1.8*, Auto, Auto, Auto" VerticalOptions="Center">
                            <!-- Term Label -->
                            <Label Grid.Column="0" 
                                Text="{Binding TermID}" 
                                FontSize="24" 
                                FontAttributes="Bold" 
                                TextColor="Black" 
                                VerticalOptions="Center" />
                            
                            <!-- Start Date Variable -->
                            <Label Grid.Column="1" 
                                Text="{Binding TermStartDate, StringFormat='{0:MM/dd/yy}'}" 
                                FontSize="14" 
                                TextColor="Gray" 
                                HorizontalOptions="End" 
                                VerticalOptions="Center" />

                            <!-- "-" placement -->
                            <Label Grid.Column="2" 
                                Text="-" 
                                Margin="2, 0"
                                FontSize="14" 
                                TextColor="Gray" 
                                HorizontalOptions="End" 
                                VerticalOptions="Center" />

                            <!-- End Date Variable -->
                            <Label Grid.Column="3" 
                                Text="{Binding TermEndDate, StringFormat='{0:MM/dd/yy}'}" 
                                FontSize="14" 
                                TextColor="Gray" 
                                HorizontalOptions="End" 
                                VerticalOptions="Center" />
                        </Grid>


                            <CollectionView ItemsSource="{Binding Classes}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Classes">
                                        <VerticalStackLayout Padding="20, 10">

                                            <Label Text="{Binding ClassName}" FontSize="18" TextColor="Black" />
                                            
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>